# RESEND for email
RESEND_API_KEY=

# UPSTASH for queue
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_TOKEN=
QSTASH_URL=

# UPSTASH redis for waiting list
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# TINY BIRD for time series data (trackers)
TINY_BIRD_API_KEY=
# Optional — defaults to the cloud API
TINYBIRD_URL=
# Optional — "true" resolves every pipe and ingest to empty
TINYBIRD_NOOP=

# TURSO SQLITE
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Solves 'UNABLE_TO_GET_ISSUER_CERT_LOCALLY', see https://github.com/nextauthjs/next-auth/issues/3580
# NODE_TLS_REJECT_UNAUTHORIZED="0"

#  For vercel upload
BLOB_READ_WRITE_TOKEN=

# STRIPE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET_KEY=

# Custom Domains
PROJECT_ID_VERCEL=
TEAM_ID_VERCEL=
VERCEL_AUTH_BEARER_TOKEN=

NEXT_PUBLIC_URL=

NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Unkey
UNKEY_API_ID=
UNKEY_TOKEN=

# GCP Messaging Queue
GCP_PROJECT_ID=
GCP_LOCATION=
GCP_CLIENT_EMAIL=
GCP_PRIVATE_KEY=
CRON_SECRET=

EXTERNAL_API_URL=
VERCEL_URL=

PLAYGROUND_UNKEY_API_KEY=

AUTH_SECRET=
AUTH_DRIZZLE_URL=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

PAGERDUTY_APP_ID=

SLACK_FEEDBACK_WEBHOOK_URL=

WORKSPACES_HIDE_URL=

# https://turbo.build/repo/docs/crafting-your-repository/using-environment-variables#loose-mode
TURBO_ENV_MODE=

NEXT_PUBLIC_OPENPANEL_CLIENT_ID=
OPENPANEL_CLIENT_SECRET=
